# Copy to .env to change defaults; docker compose reads .env automatically,
# and the harness reads the same variables from the environment
# (e.g. `set -a; . ./.env; set +a`).

# MariaDB image for all servers. The README results used 11.8 (LTS).
MARIADB_IMAGE=mariadb:11.8
# MARIADB_IMAGE=mariadb:12.3

# CPU budget per server (0 = unlimited). The reference results used 1 and 1,
# so primary and replica do not compete for CPU on a small machine.
PRIMARY_CPUS=1
REPLICA_CPUS=1

LAB_ROOT_PASSWORD=lab
PRIMARY_PORT=3307
REPLICA_PORT=3308
DELAYED_PORT=3309
# MASTER_DELAY of the delayed replica, seconds
LAB_DELAY=30
